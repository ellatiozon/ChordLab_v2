<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_drag_handle" />


    <ImageView
        android:id="@+id/btnBackProgressReport"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Close Sheet"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/text_dark" />

    <!-- Current Instrument Progress Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Current Instrument Progress"
        android:textColor="@color/accent_pink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- ── Current Instrument Progress Card ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Total Practice Minutes ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Practice Minutes"
            android:textColor="@color/accent_pink"
            android:textSize="16sp"
            android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="67%"
                android:textColor="@color/accent_pink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

    <ProgressBar
        android:id="@+id/totalPracticeMinutes"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp"
        android:max="100"
        android:progress="67"
        android:progressDrawable="@drawable/progress_bar_pink" />

            <!-- ── Weekly Practice Days ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Practice Days"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/weeklyPracticeDays"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />

            <!-- ── Chords learned ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chords Learned"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/chordsLearned"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Instruments Progress Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Instruments Progress"
        android:textColor="@color/accent_pink"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!-- ── Current Instrument Progress Card ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Instruments Explored ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instruments Explored"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/instrumentsExplored"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />

            <!-- ── Guitar Progress ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guitar Progress"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/guitarProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />

            <!-- ── Ukulele Progress── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ukulele Progress"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/ukuleleProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />

            <!-- ── Piano Progress── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Piano Progress"
                    android:textColor="@color/accent_pink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="67%"
                    android:textColor="@color/accent_pink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/pianoProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:max="100"
                android:progress="67"
                android:progressDrawable="@drawable/progress_bar_pink" />




        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>