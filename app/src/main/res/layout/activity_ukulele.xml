<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_dashboard_bg">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/txtTopTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="CHORDLAB: UKULELE"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#000000"
        app:layout_constraintHeight_percent="0.69"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.chordlab.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- LEFT SIDE OVERLAY: Fretboard Chord Diagram Guide -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCameraChordGuide"
        android:layout_width="130dp"
        android:layout_height="180dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#00000000"

        app:layout_constraintTop_toTopOf="@+id/cameraContainer"
        app:layout_constraintStart_toStartOf="@+id/cameraContainer">

        <ImageView
            android:id="@+id/imgCameraChordGuide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/c_major_uku" />
    </androidx.cardview.widget.CardView>

    <!-- RIGHT SIDE OVERLAY: Finger Identification Hand Guide -->
    <ImageView
        android:id="@+id/ivFingeringGuide"
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        android:scaleType="fitCenter"
        android:elevation="5dp"
        android:background="#D9FFFFFF"
        android:padding="1dp"
        android:src="@drawable/ic_hand_guide"
        app:layout_constraintTop_toTopOf="@+id/cameraContainer"
        app:layout_constraintEnd_toEndOf="@+id/cameraContainer" />

    <!-- FLASHCARDS MODE: Timer progress ring -->
    <ProgressBar
        android:id="@+id/timerProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:elevation="4dp"
        android:progress="100"
        android:progressDrawable="@drawable/circular_progress"
        app:layout_constraintTop_toTopOf="@+id/cameraContainer"
        app:layout_constraintStart_toStartOf="@+id/cameraContainer"
        app:layout_constraintEnd_toEndOf="@+id/cameraContainer" />

    <TextView
        android:id="@+id/txtTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15.0s"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:shadowColor="#000000"
        android:shadowRadius="4"
        app:layout_constraintBottom_toBottomOf="@+id/timerProgress"
        app:layout_constraintEnd_toEndOf="@+id/timerProgress"
        app:layout_constraintStart_toStartOf="@+id/timerProgress"
        app:layout_constraintTop_toTopOf="@+id/timerProgress" />

    <!-- FLASHCARDS MODE: Score counter -->
    <TextView
        android:id="@+id/txtScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#66000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Score: 0"
        android:textColor="#4CAF50"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@+id/ivFingeringGuide"
        app:layout_constraintEnd_toEndOf="@+id/cameraContainer" />

    <!-- AI Real-time Feedback HUD Overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/feedbackCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/cameraContainer"
        app:layout_constraintEnd_toEndOf="@+id/cameraContainer"
        app:layout_constraintStart_toStartOf="@+id/cameraContainer">

        <TextView
            android:id="@+id/txtFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D1F2EB"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="Position your fingers..."
            android:textAlignment="center"
            android:textColor="#0E6655"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="#FAF6F0"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cameraContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/txtModeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT CARD"
                android:textColor="#F08118"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtCurrentChord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C Major"
                android:textColor="#CD128B"
                android:textSize="36sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/txtModeSubtitle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtGuideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Finger Guide"
                android:textColor="#CD128B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtCurrentChord" />

            <TextView
                android:id="@+id/txtGuideDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Instructions go here."
                android:textColor="#4E342E"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtGuideTitle" />

            <LinearLayout
                android:id="@+id/practiceNavContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/txtGuideDetails"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE ROOT NOTE"
                    android:textColor="#F08118"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/layoutRootNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE QUALITY"
                    android:textColor="#F08118"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/layoutQualities"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/instructionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E61E1E1E"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            app:cardBackgroundColor="#FAF6F0"
            app:cardCornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 QUICK TIP"
                    android:textColor="#F08118"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Show only your LEFT hand (fretting hand) to the camera."
                    android:textAlignment="center"
                    android:textColor="#3E3129"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Keep your right hand away from the view for better detection."
                    android:textAlignment="center"
                    android:textColor="#4E342E"
                    android:textSize="14sp" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#DB062F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to skip"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>